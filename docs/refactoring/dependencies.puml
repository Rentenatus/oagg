  class AttrTupleManager
  class CondMember
  class CondTuple
  class DeclMember
  class DeclTuple
  class ValueMember
  class ValueTuple
  class VarTuple
  class AtomConstraint
  class Formula
}

' ===== PARSER CLASSES =====
package "Parser" {
