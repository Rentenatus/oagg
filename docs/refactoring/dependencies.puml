  class EdArc
  class EdAtomic
  class EdConstraint
  class EdGraGra
  class EdGraph
  class EdNestedApplCond
  class EdNode
  class EdRule
  class EdRuleScheme
  class EdType
}

' ===== GUI CLASSES =====
package "GUI" {
  class ConflictsDependenciesContainerSaveLoad
  class PairIOGUI
  class ApplRuleSequenceSaveLoad
  class GraGraLoad
  class GraGraSave
  class GraGraTreeView
}

' ===== LAYOUT CLASSES =====
package "Layout" {
