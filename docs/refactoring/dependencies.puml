  class Graph
  class Rule
  class Node
  class Arc
  class GraGra
  class TypeGraph
  class Match
  class TypeImpl
  class NodeTypeImpl
  class ArcTypeImpl
  class GraphObject
  class GraphElement
  class OrdinaryMorphism
  class AGGBasicAppl
  class MultiRule
  class RuleScheme
  class NestedApplCond
}

' ===== ATTRIBUTE CLASSES =====
package "Attribute" {
