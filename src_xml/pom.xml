<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>agg</groupId>
        <artifactId>agg-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>agg-xml</artifactId>
    <packaging>jar</packaging>

    <name>AGG XML Serialization Module</name>
    <description>
        XML serialization module for AGG (Attribute Grammar Generator).
        This module provides XML serialization/deserialization capabilities
        for AGG domain objects using the Adapter Pattern.
    </description>

    <dependencies>
        <dependency>
            <groupId>agg</groupId>
            <artifactId>agg-core</artifactId>
        </dependency>

        <dependency>
            <groupId>xerces</groupId>
            <artifactId>xercesImpl</artifactId>
        </dependency>

        <dependency>
            <groupId>xml-apis</groupId>
            <artifactId>xml-apis</artifactId>
        </dependency>

        <dependency>
            <groupId>de.jare.ndimcol</groupId>
            <artifactId>andimcol</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>D:/sdk_workspaces/andimcol/dist/andimcol.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
            Non-standard source layout: Java sources live directly under src_xml/
            (not under src/main/java). Test sources live under the repository-wide
            test root test_xml/java. Tests run with the repository-wide test working
            directory assets_test_xml.
        -->
        <sourceDirectory>.</sourceDirectory>
        <testSourceDirectory>../test_xml/java</testSourceDirectory>

        <resources>
            <resource>
                <directory>agg/xml/validation</directory>
                <includes>
                    <include>*.xsd</include>
                </includes>
                <targetPath>agg/xml/validation</targetPath>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <workingDirectory>${project.basedir}/../assets_test_xml</workingDirectory>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
